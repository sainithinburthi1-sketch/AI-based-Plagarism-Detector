# ============================================================
# AI-Based Plagiarism Detector — .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc

# ---- Virtual Environments ----
.venv/
venv/
env/
ENV/
.env
*.env

# ---- Distribution / Build ----
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/

# ---- Application Runtime Data ----
# Local repository files & metadata (user-specific)
data/
data/repository/
data/history.json

# ---- Uploaded / Temporary Files ----
uploads/
tmp/
temp/
*.tmp

# ---- AI Model Cache (HuggingFace) ----
# Models are downloaded automatically on first run
.cache/
huggingface_cache/

# ---- IDE & Editor ----
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace
.vs/

# ---- OS Files ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---- Jupyter Notebooks ----
.ipynb_checkpoints/
*.ipynb

# ---- Logs ----
*.log
logs/

# ---- Testing ----
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover
.tox/
nosetests.xml

# ---- Type Checking ----
.mypy_cache/
.pytype/
.pyre/

# ---- Secrets / Credentials ----
secrets.py
config.secret.py
*.pem
*.key
*.cert

# ---- Documentation Build ----
docs/_build/
site/
